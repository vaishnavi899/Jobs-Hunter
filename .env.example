# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# --- Groq (DEFAULT LLM provider, FREE tier) ---
# OpenAI-compatible API. Free key at https://console.groq.com  (rate-limited).
# Needs the optional client: uv sync --extra groq
GROQ_API_KEY=

# --- Anthropic (switchable LLM provider; set llm.provider: anthropic to use) ---
ANTHROPIC_API_KEY=

# --- Gmail API (OAuth) for email applications ---
# ONLY needed for real sending (`jobhunter send --send --i-confirm`). Dry-run
# (the default `jobhunter send`) writes .eml files to ./outbox/ with none of this.
# Real send also needs: pip install google-api-python-client google-auth-oauthlib
# Path to the OAuth client secrets JSON downloaded from Google Cloud Console.
GMAIL_OAUTH_CLIENT_SECRETS=./.auth/gmail_client_secret.json
# Token cache written after the first OAuth consent.
GMAIL_TOKEN_PATH=./.auth/gmail_token.json

# --- Telegram bot (notifications + kill switch) (checkpoint 8) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional: future paid X/Twitter API source (NOT used in v1) ---
# X_BEARER_TOKEN=

# --- Runtime ---
JOBHUNTER_DB=./jobhunter.db
